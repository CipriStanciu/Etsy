# ── Fragrance Bot dashboard — environment (copy to .env.local) ──────────────
# The dashboard runs fully on the bundled sample snapshot when no credentials
# are set (UI shows "STUB" — never misrepresenting sample data as live).
# Credentials are env-only; never commit them.

# Option A — Supabase REST (PostgREST): project URL + service role key.
#   Project Settings → API → Project URL  (e.g. https://abcdefgh.supabase.co)
#   Project Settings → API → service_role secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option B — direct Postgres (alternative to A; session pooler string).
#   Supabase Dashboard → Database → Connection string → Session pooler
POSTGRES_URL=

# Optional — default base URL used by the UTM builder when a recipe has no
# Etsy listing URL yet (e.g. the dashboard-hosted share page).
NEXT_PUBLIC_DASHBOARD_URL=